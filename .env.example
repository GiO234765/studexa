# Backend (Spring Boot) environment variables.
# Copy this file to `.env.local` or export these values in your shell.
# Never commit real secrets.

# Local PostgreSQL (created by db/setup-local.sql). No Docker.
DB_URL=jdbc:postgresql://localhost:5432/studexa
DB_USER=studexa
DB_PASSWORD=change_me_locally

# Test database used by `./mvnw test`. The name MUST end with `_test`
# (the TestDatabaseGuard refuses anything else).
TEST_DB_URL=jdbc:postgresql://localhost:5432/studexa_test

# Server
SERVER_PORT=8080

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# JWT signing secret (use a long random string, at least 32 bytes)
# ⚠️ SECURITY: this placeholder is for LOCAL DEV ONLY. ProdConfigGuard fails fast
# in production if JWT_SECRET is weak/default. Generate one:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
JWT_ISSUER=https://studexa.app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Set to true when the backend is served over HTTPS
JWT_COOKIE_SECURE=false

# Auth rate limiting (per IP, fixed window)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW=60

# Google OAuth2 login (Step 5). Leave disabled unless both credentials are set.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Beta access (enabled by default in the production profile).
BETA_ENABLED=false
BETA_REGISTRATION_OPEN=true

# Anthropic Claude API (Step 18)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_DAILY_LIMIT=10
AI_MAX_SOURCE_CHARS=12000
AI_TIMEOUT=45s

# Google Gemini API (alternative to Anthropic). Both GEMINI_ENABLED=true and a key
# are required to select Gemini. Otherwise a configured Anthropic provider is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false

# Email (Step 22)
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
